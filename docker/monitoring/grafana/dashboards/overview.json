      "targets": [
        {
          "refId": "A",
          "expr": "sum by(site, code) (rate(traefik_router_requests_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{site}} {{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
