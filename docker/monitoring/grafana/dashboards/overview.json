      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Server errors \u2014 5xx share",
      "type": "timeseries",
      "description": "No 5xx series may be absent until the first error. 4xx are shown separately and are not service failures.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by(site) (rate(traefik_router_requests_total{site=~\"$site\",code=~\"5..\"}[$__rate_interval])) or 0 * sum by(site) (rate(traefik_router_requests_total{site=~\"$site\"}[$__rate_interval]))) / sum by(site) (rate(traefik_router_requests_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "{{site}} {{router}} {{probe}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "HTTP bytes per second",
      "type": "timeseries",
      "description": "HTTP byte counters, not NIC/TLS wire traffic.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(site) (rate(traefik_router_requests_bytes_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "Received {{site}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by(site) (rate(traefik_router_responses_bytes_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "Sent {{site}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
