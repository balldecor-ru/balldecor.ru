{
  "name": "haih-site",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "build": "react-router build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/node/index.js",
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true});fs.rmSync('.react-router',{recursive:true,force:true})\"",
    "router:gen": "react-router typegen",
    "types": "npm run router:gen && tsc --noEmit",
    "types:watch": "npm run router:gen && tsc --noEmit --watch",
    "start": "cross-env NODE_ENV=production node build/node/index.js",
    "test": "node --test tests/http.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:seo": "node --experimental-strip-types --test tests/seo.test.mjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "@pothos/core": "^4.15.1",
    "@react-router/express": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "sirv": "3.0.2",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8.4.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@wyw-in-js/vite": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
